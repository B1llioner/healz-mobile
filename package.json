{
  "name": "healz-mobile",
  "version": "1.0.2",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.9",
    "expo-build-properties": "~57.0.8",
    "expo-file-system": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run postinstall && npm run typecheck && npm test && expo install --check",
    "doctor": "npx --yes expo-doctor@1.20.1",
    "prebuild:android": "expo prebuild --platform android --clean --no-install",
    "build:apk": "NODE_ENV=production ./android/gradlew -p android :app:assembleRelease",
    "postinstall": "patch-package --error-on-fail"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "npm@10.9.8",
  "private": true
}
