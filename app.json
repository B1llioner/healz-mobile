{
  "expo": {
    "name": "Healz",
    "slug": "healz-mobile",
    "version": "1.0.2",
    "scheme": "healz",
    "orientation": "default",
    "icon": "./assets/healz-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDF8F6",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.healz.mobile",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "Healz использует камеру только когда вы снимаете медицинский документ для загрузки.",
        "NSPhotoLibraryUsageDescription": "Healz открывает выбранные вами медицинские документы и изображения для загрузки в чат."
      }
    },
    "android": {
      "package": "ai.healz.mobile",
      "versionCode": 3,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FDF8F6",
        "foregroundImage": "./assets/healz-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/healz-icon.png"
    },
    "plugins": [
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "extensionBundleIdentifier": "ai.healz.mobile.ShareExtension",
            "appGroupId": "group.ai.healz.mobile",
            "activationRule": {
              "supportsImageWithMaxCount": 10,
              "supportsFileWithMaxCount": 10
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "application/pdf",
              "application/octet-stream",
              "image/*"
            ],
            "multipleShareMimeTypes": [
              "application/pdf",
              "application/octet-stream",
              "image/*",
              "*/*"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF8F6",
          "image": "./assets/healz-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.4"
          },
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "networkInspector": false,
            "usesCleartextTraffic": false
          }
        }
      ]
    ]
  }
}
