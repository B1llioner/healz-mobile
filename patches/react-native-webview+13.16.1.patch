+  if (!armed
+      || !frame.isMainFrame
+      || ![self healzUploadIsChatURL:webView.URL]
+      || !parameters.allowsMultipleSelection
+      || parameters.allowsDirectories) {
+    completionHandler(nil);
+    return;
+  }
+
+  NSArray<NSURL *> *urls = [self healzUploadStagedURLsConsuming:YES];
+  completionHandler(urls);
+  [self healzUploadRefreshUIDelegate];
+}
