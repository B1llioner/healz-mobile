+    private Uri[] takeHealzStagedFiles(
+            WebView webView,
+            String[] acceptTypes,
+            boolean allowMultiple,
+            boolean captureEnabled
+    ) {
+        if (captureEnabled || webView == null || webView.getUrl() == null) {
+            return null;
+        }
+
+        Uri pageUri = Uri.parse(webView.getUrl());
+        String pagePath = pageUri.getPath();
+        if (!"https".equals(pageUri.getScheme())
+                || !"app.healz.ai".equals(pageUri.getHost())
+                || pagePath == null
+                || !("/app/chat".equals(pagePath) || pagePath.startsWith("/app/chat/"))) {
+            return null;
+        }
+
+        Context context = webView.getContext().getApplicationContext();
+        SharedPreferences preferences = context.getSharedPreferences(HEALZ_UPLOAD_PREFS, Context.MODE_PRIVATE);
+        String rawPayload = preferences.getString(HEALZ_STAGED_FILES_KEY, null);
+        if (rawPayload == null) {
+            return null;
+        }
+
+        try {
+            JSONObject payload = new JSONObject(rawPayload);
+            long createdAt = payload.optLong("createdAt", 0L);
+            if (createdAt <= 0L || System.currentTimeMillis() - createdAt > HEALZ_STAGE_TTL_MS) {
+                preferences.edit().remove(HEALZ_STAGED_FILES_KEY).commit();
+                return null;
+            }
+
+            String nonce = payload.optString("nonce", "");
+            JSONArray files = payload.optJSONArray("files");
+            if (nonce.isEmpty() || files == null || files.length() == 0) {
+                return null;
+            }
+            if (files.length() > 1 && !allowMultiple) {
+                return null;
+            }
+
+            List<Uri> uris = new ArrayList<>();
+            String expectedAuthority = context.getPackageName() + ".HealzUploadFileProvider";
+            for (int index = 0; index < files.length(); index += 1) {
+                JSONObject file = files.getJSONObject(index);
+                String mimeType = file.optString("mimeType", "");
+                if (!isAcceptedHealzMime(mimeType, acceptTypes)) {
+                    return null;
+                }
+
+                Uri uri = Uri.parse(file.optString("uri", ""));
+                if (!"content".equals(uri.getScheme()) || !expectedAuthority.equals(uri.getAuthority())) {
+                    return null;
+                }
+                uris.add(uri);
+            }
+
+            boolean consumed = preferences.edit()
+                    .remove(HEALZ_STAGED_FILES_KEY)
+                    .putString(HEALZ_CONSUMED_NONCE_KEY, nonce)
+                    .putLong(HEALZ_CONSUMED_AT_KEY, System.currentTimeMillis())
+                    .commit();
+            return consumed ? uris.toArray(new Uri[0]) : null;
+        } catch (Exception ignored) {
+            return null;
+        }
+    }
+
+    private boolean isAcceptedHealzMime(String mimeType, String[] acceptTypes) {
+        if (!("application/pdf".equals(mimeType) || mimeType.startsWith("image/"))) {
+            return false;
+        }
+        if (acceptTypes == null || acceptTypes.length == 0) {
+            return false;
+        }
+
+        boolean acceptsPdf = false;
+        boolean acceptsImages = false;
+        boolean acceptsMime = false;
+        for (String rawAcceptType : acceptTypes) {
+            if (rawAcceptType == null) continue;
+            String[] values = rawAcceptType.toLowerCase().split(",");
+            for (String rawValue : values) {
+                String value = rawValue.trim();
+                if ("application/pdf".equals(value)) acceptsPdf = true;
+                if ("image/*".equals(value)) acceptsImages = true;
+                if ("*/*".equals(value)
+                        || value.equals(mimeType)
+                        || (value.endsWith("/*") && mimeType.startsWith(value.substring(0, value.length() - 1)))) {
+                    acceptsMime = true;
+                }
+            }
+        }
+        return acceptsPdf && acceptsImages && acceptsMime;
+    }
