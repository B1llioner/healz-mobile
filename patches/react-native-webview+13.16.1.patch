+- (NSArray<NSURL *> *)healzUploadStagedURLsConsuming:(BOOL)consume
+{
+  NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
+  NSString *rawPayload = [defaults stringForKey:HealzUploadStagedKey];
+  if (rawPayload == nil) {
+    return nil;
+  }
+
+  NSData *payloadData = [rawPayload dataUsingEncoding:NSUTF8StringEncoding];
+  NSDictionary *payload = payloadData == nil
+      ? nil
+      : [NSJSONSerialization JSONObjectWithData:payloadData options:0 error:nil];
+  if (![payload isKindOfClass:[NSDictionary class]]) {
+    return nil;
+  }
+
+  NSString *nonce = payload[@"nonce"];
+  NSNumber *createdAt = payload[@"createdAt"];
+  NSArray *files = payload[@"files"];
+  NSTimeInterval now = [NSDate date].timeIntervalSince1970;
+  if (![nonce isKindOfClass:[NSString class]]
+      || nonce.length == 0
+      || ![createdAt isKindOfClass:[NSNumber class]]
+      || now - createdAt.doubleValue / 1000.0 > HealzUploadStageTTL
+      || ![files isKindOfClass:[NSArray class]]
+      || files.count == 0
+      || files.count > 10) {
+    return nil;
+  }
+
+  NSURL *applicationSupport = [[[NSFileManager defaultManager]
+      URLsForDirectory:NSApplicationSupportDirectory
+      inDomains:NSUserDomainMask] firstObject];
+  NSURL *pendingRoot = [applicationSupport URLByAppendingPathComponent:@"healz-pending" isDirectory:YES];
+  pendingRoot = [[pendingRoot URLByStandardizingPath] URLByResolvingSymlinksInPath];
+  if (pendingRoot == nil) {
+    return nil;
+  }
+
+  NSMutableArray<NSURL *> *urls = [NSMutableArray arrayWithCapacity:files.count];
+  long long totalSize = 0;
+  for (id rawFile in files) {
+    if (![rawFile isKindOfClass:[NSDictionary class]]) {
+      return nil;
+    }
+    NSDictionary *file = rawFile;
+    NSString *identifier = file[@"id"];
+    NSString *mimeType = file[@"mimeType"];
+    NSString *rawURL = file[@"uri"];
+    NSUUID *uuid = [identifier isKindOfClass:[NSString class]]
+        ? [[NSUUID alloc] initWithUUIDString:identifier]
+        : nil;
+    NSURL *url = [rawURL isKindOfClass:[NSString class]] ? [NSURL URLWithString:rawURL] : nil;
+    if (uuid == nil || ![self healzUploadIsSupportedMimeType:mimeType] || !url.isFileURL) {
+      return nil;
+    }
+
+    url = [[url URLByStandardizingPath] URLByResolvingSymlinksInPath];
+    NSURL *itemRoot = [pendingRoot URLByAppendingPathComponent:uuid.UUIDString.lowercaseString isDirectory:YES];
+    NSString *itemPrefix = [itemRoot.path stringByAppendingString:@"/"];
+    BOOL isDirectory = NO;
+    BOOL exists = [[NSFileManager defaultManager] fileExistsAtPath:url.path isDirectory:&isDirectory];
+    NSDictionary *attributes = exists && !isDirectory
+        ? [[NSFileManager defaultManager] attributesOfItemAtPath:url.path error:nil]
+        : nil;
+    NSNumber *size = attributes[NSFileSize];
+    if (![url.path hasPrefix:itemPrefix]
+        || ![size isKindOfClass:[NSNumber class]]
+        || size.longLongValue < 0
+        || size.longLongValue > 20LL * 1024LL * 1024LL) {
+      return nil;
+    }
+    totalSize += size.longLongValue;
+    if (totalSize > 100LL * 1024LL * 1024LL) {
+      return nil;
+    }
+    [urls addObject:url];
+  }
+
+  if (consume) {
+    // Write the consumed marker first so the React polling loop can observe
+    // either staged or consumed, never a transient empty state.
+    [defaults setObject:nonce forKey:HealzUploadConsumedNonceKey];
+    [defaults setDouble:now * 1000.0 forKey:HealzUploadConsumedAtKey];
+    [defaults removeObjectForKey:HealzUploadStagedKey];
+  }
+  return urls;
+}
